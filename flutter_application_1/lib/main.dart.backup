  @override
  void initState() {
    super.initState();

    _apiService = ApiService(baseUrl, _token);
    _initData();
    _loadCoins();

    _bgTimer = Timer.periodic(const Duration(hours: 1), (timer) {
      if (mounted && _isAuthenticated) {
        _refreshAchievements();
      }
    });

    _updateTimer = Timer.periodic(const Duration(minutes: 5), (timer) {
      if (mounted && _flower != null && _isAuthenticated) {
        _updateFlowerState();
      }
    });
  }

  @override
  void dispose() {
    _bgTimer?.cancel();
    _updateTimer?.cancel();
    super.dispose();
  }

  String _getBackgroundImage() {
    final now = DateTime.now();
    final hour = now.hour;

    if (hour >= 4 && hour < 17) return 'assets/backgrounds/room.jpeg';
    if (hour >= 17 && hour < 19) return 'assets/backgrounds/room2.jpeg';
    return 'assets/backgrounds/room3.jpeg';
  }

  Future<void> _initData() async {
    await _loadFlowerTypes();
    await _loadPots();
    await _checkAuth();
  }

  Future<void> _checkAuth() async {
    final prefs = await SharedPreferences.getInstance();
    final savedToken = prefs.getString('auth_token');

    if (savedToken != null && savedToken.isNotEmpty) {
      _token = savedToken;
      _apiService = ApiService(baseUrl, _token);
      setState(() {
        _isAuthenticated = true;
        _showLoginDialog = false;
      });
      await _loadData();
      await _loadUserProfile();
      await _loadAchievements();
      await _checkDailyLogin();
    } else {
      setState(() {
        _showLoginDialog = true;
        _isLoading = false;
      });
    }
  }

  Future<void> _checkDailyLogin() async {
    if (_token.isEmpty) return;

    try {
      final uri = Uri.parse("$baseUrl/api/daily-login/");
      final res = await http.post(
        uri,
        headers: {
          'Authorization': 'Token $_token',
          'Content-Type': 'application/json',
        },
      );

      print('📡 Daily login статус: ${res.statusCode}');
      print('📡 Daily login ответ: ${res.body}');

      if (res.statusCode == 200) {
        final data = jsonDecode(res.body);

        setState(() {
          _dailyStreak = data['streak'] ?? 1;
          _dailyReward = data['reward'] ?? 1;
          _showDailyLoginDialog = true;
        });
      }
    } catch (e) {
      print('❌ Ошибка daily login: $e');
    }
  }

  Future<void> _loadUserProfile() async {
    if (_token.isEmpty) return;

    try {
      final uri = Uri.parse("$baseUrl/api/profile/");
      final res = await http.get(
        uri,
        headers: {
          'Authorization': 'Token $_token',
          'Content-Type': 'application/json',
        },
      );

      if (res.statusCode == 200) {
        final data = jsonDecode(res.body);

        if (data is List && data.isNotEmpty) {
          final userData = data[0];
          setState(() {
            _profileUsername =
                userData['username']?.toString() ?? 'Пользователь';
            _profileEmail = userData['email']?.toString() ?? 'email не указан';
            _coins = userData['coins'] ?? _coins;
          });
        } else if (data is Map) {
          setState(() {
            _profileUsername = data['username']?.toString() ?? 'Пользователь';
            _profileEmail = data['email']?.toString() ?? 'email не указан';
            _coins = data['coins'] ?? _coins;
          });
        }
      }
    } catch (e) {
      debugPrint('Ошибка загрузки профиля: $e');
      setState(() {
        _profileUsername = 'Пользователь';
        _profileEmail = 'email не указан';
      });
    }
  }

  Future<void> _logout() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.remove('auth_token');

    setState(() {
      _showProfileDialog = false;
      _isAuthenticated = false;
      _showLoginDialog = true;
      _flower = null;
      _flowerType = null;
      _flowerPot = null;
      _profileUsername = '';
      _profileEmail = '';
      _achievements = [];
    });
  }

  Future<void> _loadFlowerTypes() async {
    final types = await _apiService.loadFlowerTypes();
    setState(() => _flowerTypes = types);
  }

  Future<void> _loadPots() async {
    final pots = await _apiService.loadPots();
    setState(() => _pots = pots);
  }

  Future<void> _updateFlowerState() async {
    if (_flower == null || _isUpdatingFlower) return;
    _isUpdatingFlower = true;
    try {
      await _apiService.updateFlowerState(_flower!['id']);
      await _loadData();
      await _refreshAchievements();
    } catch (e) {
      debugPrint('Ошибка обновления состояния: $e');
    } finally {
      _isUpdatingFlower = false;
    }
  }

  void _calculateNeedWater() {
    if (_flower == null) {
      _needWaterCount = 0;
      return;
    }

    final waterLevel = _flower!['water_level'] ?? 0;

    if (waterLevel > 90) {
      _needWaterCount = 0;
    } else if (waterLevel > 70) {
      _needWaterCount = 1;
    } else if (waterLevel > 50) {
      _needWaterCount = 2;
    } else if (waterLevel > 30) {
      _needWaterCount = 3;
    } else if (waterLevel > 10) {
      _needWaterCount = 4;
    } else {
      _needWaterCount = 5;
    }
  }

  Duration? _getRepotCooldown() {
    if (_flower == null) return null;
    final lastRepot = _flower!['last_repot_at'];
    if (lastRepot == null) return null;

    final last = DateTime.tryParse(lastRepot.toString());
    if (last == null) return null;

    final next = last.add(const Duration(days: 2));
    final now = DateTime.now();
    if (now.isAfter(next)) return null;
    return next.difference(now);
  }

  String _formatCooldown(Duration d) {
    final days = d.inDays;
    final hours = d.inHours % 24;
    final minutes = d.inMinutes % 60;
    if (days > 0) return 'Через $days д $hours ч';
    if (hours > 0) return 'Через $hours ч $minutes мин';
    return 'Через $minutes мин';
  }

  Future<void> _loadData() async {
    setState(() => _isLoading = true);
    try {
      final flowers = await _apiService.loadFlowers();

      if (flowers.isNotEmpty) {
        final flowerData = flowers.first;
        final flowerTypeId = flowerData['flower_type'];

        Map<String, dynamic>? foundType;
        for (var type in _flowerTypes) {
          if (type['id'] == flowerTypeId) {
            foundType = type;
            break;
          }
        }

        final potId = flowerData['pot'];
        Map<String, dynamic>? foundPot;
        for (var pot in _pots) {
          if (pot['id'] == potId) {
            foundPot = pot;
            break;
          }
        }

        setState(() {
          _flower = flowerData;
          _flowerType = foundType;
          _flowerPot = foundPot;
        });

        _calculateNeedWater();
      } else {
        setState(() {
          _flower = null;
          _flowerType = null;
          _flowerPot = null;
          _needWaterCount = 0;
        });
      }
      setState(() => _isLoading = false);
    } catch (e) {
      debugPrint('❌ Ошибка: $e');
      setState(() => _isLoading = false);
    }
  }

  Future<void> _waterFlower() async {
    if (_flower == null) return;

    final currentWaterLevel = _flower!['water_level'] ?? 0;
    if (currentWaterLevel >= 100) return;

    final success = await _apiService.waterFlower(_flower!['id']);
    if (success) {
      _animateCoinFromFlower();

      await _loadData();
      await _loadUserProfile();
      await _refreshAchievements();
    }
  }

  Future<void> _repotFlower(int newPotId) async {
    if (_flower == null) return;

    final result = await _apiService.repotFlower(_flower!['id'], newPotId);

    if (result['success'] == true) {
      if (mounted) {
        setState(() {
          _coins = result['coins'] ?? _coins;
        });
        _saveCoins();
        _animateCoinFromFlower();
      }
      await _loadData();
      await _loadUserProfile();
      await _refreshAchievements();
    } else {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(result['message'] ?? 'Ошибка пересадки'),
            backgroundColor: const Color.fromARGB(255, 184, 69, 60),
          ),
        );
      }
    }
  }

  Future<void> _deleteFlower() async {
    if (_flower == null) return;

    final confirm = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Удалить цветок?',
            style: TextStyle(color: Colors.black)),
        content: const Text('Вы уверены, что хотите удалить этот цветок?',
            style: TextStyle(color: Colors.black)),
        backgroundColor: Colors.white,
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            style: TextButton.styleFrom(
                backgroundColor: Colors.green, foregroundColor: Colors.white),
            child: const Text('Отмена'),
          ),
          TextButton(
            onPressed: () => Navigator.pop(context, true),
            style: TextButton.styleFrom(
                backgroundColor: Colors.purple, foregroundColor: Colors.white),
            child: const Text('Удалить'),
          ),
        ],
      ),
    );

    if (confirm == true) {
      final success = await _apiService.deleteFlower(_flower!['id']);
      if (success) {
        await _loadData();
        await _refreshAchievements();
      }
    }
  }

  void _showCreateFlower(int flowerTypeId) async {
    setState(() => _showFlowerSelector = false);

    final potId = await showModalBottomSheet<int>(
      context: context,
      backgroundColor: Colors.transparent,
      builder: (context) => PotSelector(
        baseUrl: baseUrl,
        pots: _pots,
        selectedPotId: null,
        onPotSelected: (id) => Navigator.pop(context, id),
        onCancel: () => Navigator.pop(context, null),
      ),
    );

    if (potId != null) {
      setState(() => _isLoading = true);
      final success =
          await _apiService.createFlower(flowerTypeId, potId, 'Мой цветок');
      if (success) {
        await Future.delayed(const Duration(milliseconds: 500));
        await _loadData();
        await _refreshAchievements();
      }
      setState(() => _isLoading = false);
    }
  }

  void _showPotSelectorForRepot() async {
    if (_flower == null) return;

    final newPotId = await showModalBottomSheet<int>(
      context: context,
      backgroundColor: Colors.transparent,
      builder: (context) => _RepotSheet(
        baseUrl: baseUrl,
        pots: _pots,
        currentPotId: _flowerPot?['id'],
        getCooldown: _getRepotCooldown,
        formatCooldown: _formatCooldown,
      ),
    );

    if (newPotId != null) {
      await _repotFlower(newPotId);
    }
  }

  // ==================== ОТОБРАЖЕНИЕ ====================
  String _getStageFileName(String stage, String flowerType) {
    final isAlive = _flower?['is_alive'] ?? true;
    if (!isAlive) {
      if (flowerType == 'monstera') return 'wilted_mon6.png';
      if (flowerType == 'orchid') return 'wilted_or6.png';
      return 'wilted_wi6.png';
    }

    switch (stage) {
      case 'seed':
        return '1.png';
      case 'sprout':
        if (flowerType == 'monstera') return 'mon2.png';
        if (flowerType == 'orchid') return 'or2.png';
        return 'wi2.png';
      case 'growing':
        if (flowerType == 'monstera') return 'mon3.png';
        if (flowerType == 'orchid') return 'or3.png';
        return 'wi3.png';
      case 'mature':
        if (flowerType == 'monstera') return 'mon4.png';
        if (flowerType == 'orchid') return 'or4.png';
        return 'wi4.png';
      case 'flowering':
        if (flowerType == 'monstera') return 'mon5.png';
        if (flowerType == 'orchid') return 'or5.png';
        return 'wi5.png';
      default:
        return '1.png';
    }
  }

  String _getDisplayFlowerName() {
    if (_flowerType == null) return 'Цветок';
    final type = _flowerType!['type'] ?? 'violet';
    switch (type) {
      case 'violet':
        return 'Фиалка';
      case 'orchid':
        return 'Орхидея';
      case 'monstera':
        return 'Монстера';
      default:
        return 'Цветок';
    }
  }

  String _getDisplayFlowerType() {
    if (_flowerType == null) return '';
    final type = _flowerType!['type'] ?? 'violet';
    switch (type) {
      case 'violet':
        return 'Сенполия';
      case 'orchid':
        return 'Фаленопсис';
      case 'monstera':
        return 'Деликатесная';
      default:
        return '';
    }
  }

  String _getFlowerDisplayName(String? type) {
    switch (type) {
      case 'violet':
        return 'Фиалка';
      case 'orchid':
        return 'Орхидея';
      case 'monstera':
        return 'Монстера';
      default:
        return 'Цветок';
    }
  }

  double _getHealthProgress() {
    return (_flower?['health'] ?? 0).toDouble() / 100;
  }

  double _getWaterProgress() {
    return (_flower?['water_level'] ?? 0).toDouble() / 100;
  }

  double _getGrowthProgress() {
    if (_flower == null || _flowerType == null) return 0;
    final maxHeight = _flowerType!['max_height'] ?? 100;
    final currentHeight = (_flower!['height'] ?? 0).toDouble();
    if (maxHeight <= 0) return 0;
    double progress = currentHeight / maxHeight;
    return progress.clamp(0.0, 1.0);
  }

  double _getBottomOffset(String stage, String flowerType) {
    final isAlive = _isFlowerAlive;

    if (!isAlive) {
      if (flowerType == 'monstera') return 110;
      if (flowerType == 'orchid') return 30;
      return 50;
    }

    if (flowerType == 'monstera') {
      switch (stage) {
        case 'seed':
          return 10;
        case 'sprout':
          return 50;
        case 'growing':
          return 50;
        case 'mature':
          return 70;
        case 'flowering':
          return 100;
        default:
          return 60;
      }
    } else if (flowerType == 'orchid') {
      switch (stage) {
        case 'seed':
          return 10;
        case 'sprout':
          return 30;
        case 'growing':
          return 40;
        case 'mature':
          return 50;
        case 'flowering':
          return 50;
        default:
          return 50;
      }
    } else {
      switch (stage) {
        case 'seed':
          return 10;
        case 'sprout':
          return 40;
        case 'growing':
          return 40;
        case 'mature':
          return 38;
        case 'flowering':
          return 50;
        default:
          return 50;
      }
    }
  }

  bool get _isFlowerAlive => _flower?['is_alive'] ?? true;

  Widget _buildPlantImage() {
    if (_flower == null) return const SizedBox();

    final flowerType = _flowerType?['type'] ?? 'violet';
    final stage = _flower!['stage'] ?? 'seed';
    final pot = _flowerPot;
    final isAlive = _isFlowerAlive;

    final bool hasPot = pot != null && pot['image'] != null;

    String potImageUrl = '';
    if (hasPot) {
      potImageUrl = pot!['image'];
      if (potImageUrl.isNotEmpty && !potImageUrl.startsWith('http')) {
        potImageUrl = '$baseUrl$potImageUrl';
      }
    }

    final screenWidth = MediaQuery.of(context).size.width;
    final screenHeight = MediaQuery.of(context).size.height;

    final isPhone = screenWidth < 600;
    final containerSize = screenWidth * 0.8;
    final potWidth = screenWidth * 0.65;
    final potHeight = potWidth * 0.7;
    final plantSize = screenWidth * 0.45;
    final scaleFactor = screenHeight / 800;

    return GestureDetector(
      onTap: _onSingleTap,
      onDoubleTap: _onDoubleTap,
      child: Stack(
        children: [
          SizedBox(
            width: containerSize,
            height: containerSize,
            child: Stack(
              alignment: Alignment.bottomCenter,
              children: [
                if (hasPot)
                  Positioned(
                    bottom: screenHeight * 0.00001,
                    child: Image.network(
                      potImageUrl,
                      width: potWidth,
                      height: potHeight,
                      fit: BoxFit.contain,
                      errorBuilder: (_, __, ___) => Container(
                        width: potWidth,
                        height: potHeight,
                        decoration: BoxDecoration(
                          color: Colors.brown.withOpacity(0.5),
                          borderRadius: BorderRadius.circular(10),
                        ),
                        child: const Icon(Icons.grass,
                            color: Colors.brown, size: 40),
                      ),
                    ),
                  )
                else
                  Positioned(
                    bottom: screenHeight * 0.02,
                    child: Container(
                      width: potWidth,
                      height: potHeight,
                      decoration: BoxDecoration(
                        color: Colors.brown.withOpacity(0.5),
                        borderRadius: BorderRadius.circular(10),
                      ),
                      child: const Icon(Icons.grass,
                          color: Colors.brown, size: 40),
                    ),
                  ),
                Positioned(
                  bottom: isAlive
                      ? _getBottomOffset(stage, flowerType) * scaleFactor
                      : screenHeight * 0.03,
                  child: Image.asset(
                    'assets/plants/$flowerType/${_getStageFileName(stage, flowerType)}',
                    width: plantSize,
                    height: plantSize,
                    fit: BoxFit.contain,
                    errorBuilder: (_, __, ___) => Icon(
                      Icons.local_florist,
                      size: plantSize * 0.8,
                      color: Colors.grey,
                    ),
                  ),
                ),
              ],
            ),
          ),
          if (_showLottie)
            Positioned(
              top: screenHeight * 0.275,
              left: screenWidth * 0.335,
              child: Lottie.asset(
                'assets/animations/eyes.json',
                width: 75,
                height: 75,
                repeat: false,
              ),
            ),
          if (_showJoyLottie)
            Positioned(
              top: isPhone ? screenHeight * 0.25 : screenHeight * 0.27,
              left: isPhone ? screenWidth * 0.22 : screenWidth * 0.25,
              child: Lottie.asset(
                'assets/animations/confetti.json',
                width: isPhone ? screenWidth * 0.1 : screenWidth * 0.08,
                height: isPhone ? screenWidth * 0.1 : screenWidth * 0.08,
                repeat: false,
              ),
            ),
          if (_showImage)
            Positioned(
              top: isPhone ? screenHeight * 0.25 : screenHeight * 0.27,
              left: isPhone ? screenWidth * 0.22 : screenWidth * 0.25,
              child: Image.asset(
                'assets/images/anger.png',
                width: isPhone ? screenWidth * 0.16 : screenWidth * 0.12,
                height: isPhone ? screenWidth * 0.16 : screenWidth * 0.12,
                fit: BoxFit.contain,
              ),
            ),
        ],
      ),
    );
  }

  Widget _buildProgressBar(double value, Color color, String label) {
    final screenWidth = MediaQuery.of(context).size.width;
    final isSmallScreen = screenWidth < 400;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Expanded(
              child: Text(
                label,
                style: TextStyle(
                  fontSize: isSmallScreen ? 10 : 12,
                  color: Colors.black,
                  fontWeight: FontWeight.w500,
                ),
                overflow: TextOverflow.ellipsis,
              ),
            ),
            const SizedBox(width: 8),
            Text(
              '${(value * 100).toInt()}%',
              style: TextStyle(
                fontSize: isSmallScreen ? 12 : 15,
                color: Colors.black,
                fontWeight: FontWeight.w600,
              ),
            ),
          ],
        ),
        const SizedBox(height: 4),
        LinearProgressIndicator(
          value: value,
          backgroundColor: color.withOpacity(0.2),
          color: color,
          minHeight: isSmallScreen ? 6 : 8,
          borderRadius: BorderRadius.circular(4),
        ),
      ],
    );
  }

  Widget _buildSelectorOverlay() {
    return Stack(
      children: [
        Container(
          color: Colors.black.withOpacity(0.7),
          child: GestureDetector(
            onTap: () => setState(() => _showFlowerSelector = false),
          ),
        ),
        Center(
          child: Container(
            margin: const EdgeInsets.all(20),
            padding: const EdgeInsets.all(20),
            constraints: BoxConstraints(
              maxHeight: MediaQuery.of(context).size.height * 0.8,
              maxWidth: 500,
            ),
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(30),
            ),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                const Text(
                  'Выберите цветок',
                  style: TextStyle(
                    fontSize: 22,
                    fontWeight: FontWeight.bold,
                    color: Colors.black,
                  ),
                ),
                const SizedBox(height: 16),
                Flexible(
                  child: GridView.builder(
                    shrinkWrap: true,
                    physics: const BouncingScrollPhysics(),
                    gridDelegate:
                        const SliverGridDelegateWithFixedCrossAxisCount(
                      crossAxisCount: 2,
                      crossAxisSpacing: 12,
                      mainAxisSpacing: 12,
                      childAspectRatio: 0.65,
                    ),
                    itemCount: _flowerTypes.length,
                    itemBuilder: (context, index) {
                      final type = _flowerTypes[index];
                      final String flowerType = type['type'];
                      final String flowerName =
                          _getFlowerDisplayName(flowerType);
                      final String description =
                          (type['description'] ?? '').toString();

                      String imagePath;
                      switch (flowerType) {
                        case 'violet':
                          imagePath = 'assets/plants/violet/wi5.png';
                          break;
                        case 'orchid':
                          imagePath = 'assets/plants/orchid/or5.png';
                          break;
                        case 'monstera':
                          imagePath = 'assets/plants/monstera/mon5.png';
                          break;
                        default:
                          imagePath = 'assets/plants/violet/wi5.png';
                      }

                      return GestureDetector(
                        onTap: () => _showCreateFlower(type['id']),
                        child: Container(
                          padding: const EdgeInsets.all(10),
                          decoration: BoxDecoration(
                            color: Colors.green.withOpacity(0.08),
                            borderRadius: BorderRadius.circular(16),
                            border: Border.all(
                              color: Colors.green.withOpacity(0.3),
                              width: 1,
                            ),
                          ),
                          child: Column(
                            mainAxisAlignment: MainAxisAlignment.center,
                            children: [
                              Container(
                                width: 110,
                                height: 110,
                                child: ClipRRect(
                                  borderRadius: BorderRadius.circular(12),
                                  child: Image.asset(
                                    imagePath,
                                    fit: BoxFit.contain,
                                    errorBuilder:
                                        (context, error, stackTrace) {
                                      return const Icon(
                                        Icons.local_florist,
                                        size: 40,
                                        color: Colors.green,
                                      );
                                    },
                                  ),
                                ),
                              ),
                              const SizedBox(height: 6),
                              Text(
                                flowerName,
                                style: const TextStyle(
                                  fontSize: 18,
                                  fontWeight: FontWeight.bold,
                                  color: Color.fromARGB(255, 2, 1, 1),
                                ),
                                textAlign: TextAlign.center,
                              ),
                              const SizedBox(height: 4),
                              if (description.isNotEmpty)
                                Flexible(
                                  child: SingleChildScrollView(
                                    physics:
                                        const BouncingScrollPhysics(),
                                    child: Text(
                                      description,
                                      style: TextStyle(
                                        fontSize: 13,
                                        color: const Color.fromARGB(
                                            255, 44, 44, 44),
                                        height: 1.3,
                                      ),
                                      textAlign: TextAlign.center,
                                    ),
                                  ),
                                ),
                            ],
                          ),
                        ),
                      );
                    },
                  ),
                ),
                const SizedBox(height: 16),
                ElevatedButton(
                  onPressed: () =>
                      setState(() => _showFlowerSelector = false),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.grey,
                    padding: const EdgeInsets.symmetric(
                        horizontal: 40, vertical: 12),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(30),
                    ),
                  ),
                  child: const Text('Отмена'),
                ),
              ],
            ),
          ),
        ),
      ],
    );
  }

