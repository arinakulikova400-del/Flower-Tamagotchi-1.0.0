            )
          : null,
    );
  }
}

// ==================== КЛАСС ДОСТИЖЕНИЯ ====================
enum AchievementType { flower, water, collection, growth }

class Achievement {
  final String id;
  final String title;
  final String description;
  final String imagePath;
  final int requiredValue;
  final int reward;
  int currentValue;
  bool isCompleted;
  bool isClaimed;
  final AchievementType type;

  Achievement({
    required this.id,
    required this.title,
    required this.description,
    required this.imagePath,
    required this.requiredValue,
    required this.reward,
    required this.currentValue,
    required this.type,
    this.isCompleted = false,
    this.isClaimed = false,
  });

  /// Справочник: id → метаданные (title, description, image, required, type).
  /// reward приходит с сервера, поэтому здесь только клиентские поля.
  static const Map<String, Map<String, dynamic>> CATALOG = {
    'first_flower': {
      'title': 'Первый цветок',
      'description': 'Посадите первый цветок',
      'imagePath': 'assets/images/achievements/blossom.png',
      'requiredValue': 1,
      'type': AchievementType.flower,
    },
    'water_10': {
      'title': 'Заботливый садовод',
      'description': 'Полейте цветок 10 раз',
      'imagePath': 'assets/images/achievements/watering1.png',
      'requiredValue': 10,
      'type': AchievementType.water,
    },
    'water_50': {
      'title': 'Мастер полива',
      'description': 'Полейте цветок 50 раз',
      'imagePath': 'assets/images/achievements/watering2.png',
      'requiredValue': 50,
      'type': AchievementType.water,
    },
    'violet_grow': {
      'title': 'Коллекционер фиалок',
      'description': 'Вырастите фиалку',
      'imagePath': 'assets/images/achievements/violet.png',
      'requiredValue': 1,
      'type': AchievementType.collection,
    },
    'orchid_grow': {
      'title': 'Коллекционер орхидей',
      'description': 'Вырастите орхидею',
      'imagePath': 'assets/images/achievements/orchid.png',
      'requiredValue': 1,
      'type': AchievementType.collection,
    },
    'monstera_grow': {
      'title': 'Коллекционер монстер',
      'description': 'Вырастите монстеру',
      'imagePath': 'assets/images/achievements/monster.png',
      'requiredValue': 1,
      'type': AchievementType.collection,
    },
    'growth_10': {
      'title': 'Первые сантиметры',
      'description': 'Вырастите цветок до 10 см',
      'imagePath': 'assets/images/achievements/ruler.png',
      'requiredValue': 10,
      'type': AchievementType.growth,
    },
    'flowering': {
      'title': 'Первое цветение',
      'description': 'Дождитесь цветения',
      'imagePath': 'assets/images/achievements/blossom.png',
      'requiredValue': 1,
      'type': AchievementType.growth,
    },
  };

  /// Создать Achievement из ответа сервера `/api/achievements/`
  factory Achievement.fromServer(Map<String, dynamic> json) {
    final id = json['id'] as String;
    final meta = CATALOG[id] ?? {};

    return Achievement(
      id: id,
      title: meta['title'] ?? id,
      description: meta['description'] ?? '',
      imagePath:
          meta['imagePath'] ?? 'assets/images/achievements/blossom.png',
      requiredValue: meta['requiredValue'] ?? 1,
      reward: json['reward'] ?? 0,
      currentValue: json['current_value'] ?? 0,
      isCompleted: json['is_completed'] ?? false,
      isClaimed: json['is_claimed'] ?? false,
      type: meta['type'] ?? AchievementType.flower,
    );
  }
}

// ==================== КЛИПЕР СО СКОШЕННЫМИ УГЛАМИ ====================
class _ChamferedClipper extends CustomClipper<Path> {
  final double cut;
  _ChamferedClipper({this.cut = 14});

  @override
  Path getClip(Size size) {
    final w = size.width;
    final h = size.height;
    final c = cut;
    return Path()
      ..moveTo(c, 0)
      ..lineTo(w - c, 0)
      ..lineTo(w, c)
      ..lineTo(w, h - c)
      ..lineTo(w - c, h)
      ..lineTo(c, h)
      ..lineTo(0, h - c)
      ..lineTo(0, c)
      ..close();
  }

  @override
  bool shouldReclip(covariant CustomClipper<Path> oldClipper) => false;
}

// ==================== ЛИАНА С ЛИСТОЧКАМИ ====================
class LeafProgressBar extends StatelessWidget {
  final int current;
  final int total;
  final int leafCount;

  const LeafProgressBar({
    super.key,
    required this.current,
    required this.total,
    this.leafCount = 7,
  });

  @override
  Widget build(BuildContext context) {
    final double progress =
        total == 0 ? 0.0 : (current / total).clamp(0.0, 1.0);
    return SizedBox(
      height: 34,
      child: CustomPaint(
        painter: _LeafPainter(
          progress: progress,
          leafCount: leafCount,
        ),
        child: const SizedBox.expand(),
      ),
    );
  }
}

class _LeafPainter extends CustomPainter {
  final double progress;
  final int leafCount;

  _LeafPainter({
    required this.progress,
    required this.leafCount,
  });

  @override
  void paint(Canvas canvas, Size size) {
    final double w = size.width;
    final double h = size.height;
    final double centerY = h / 2;

    // 1. Серая подложка
    final bgLinePaint = Paint()
      ..color = const Color(0xFFDDDDDD)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 6
      ..strokeCap = StrokeCap.round;

    canvas.drawLine(Offset(0, centerY), Offset(w, centerY), bgLinePaint);

    // 2. Оранжевый прогресс
    final progressPaint = Paint()
      ..color = const Color(0xFFFF9800)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 6
      ..strokeCap = StrokeCap.round;

    canvas.drawLine(
      Offset(0, centerY),
      Offset(w * progress, centerY),
      progressPaint,
    );

    // 3. Лиана
    final vinePaint = Paint()
      ..color = const Color(0xFF2E4A2E)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 5
      ..strokeCap = StrokeCap.round;

    final vinePath = Path();
    final double amplitude = 6;
    final double step = leafCount > 1 ? w / (leafCount - 1) : w;
    final double halfWave = step;

    vinePath.moveTo(0, centerY - amplitude);
    double x = 0;
    bool up = false;
    while (x < w) {
      x += halfWave;
      if (x > w) x = w;
      final midX = x - halfWave / 2;
      if (midX > 0) {
        vinePath.quadraticBezierTo(
          midX,
          up ? centerY + amplitude * 2 : centerY - amplitude * 2,
          x,
          up ? centerY + amplitude : centerY - amplitude,
        );
      } else {
        vinePath.lineTo(x, up ? centerY + amplitude : centerY - amplitude);
      }
      up = !up;
    }

    canvas.drawPath(vinePath, vinePaint);

    // 4. Листочки
    for (int i = 0; i < leafCount; i++) {
      final double leafX = i * step;
      final double leafY = centerY + (i % 2 == 0 ? -amplitude : amplitude);

      final bool filled = (leafCount > 1)
          ? (i / (leafCount - 1)) <= progress + 0.0001
          : progress >= 1.0;

      final leafPaint = Paint()
        ..color = filled ? const Color(0xFF4CAF50) : const Color(0xFF9E9E9E)
        ..style = PaintingStyle.fill;

      canvas.save();
      canvas.translate(leafX, leafY);
      canvas.rotate(i % 2 == 0 ? -0.6 : 0.6);

      final leafRect = Rect.fromCenter(
        center: Offset.zero,
        width: 12,
        height: 6,
      );
      canvas.drawOval(leafRect, leafPaint);
      canvas.restore();
    }
  }

  @override
  bool shouldRepaint(covariant _LeafPainter oldDelegate) {
    return oldDelegate.progress != progress ||
        oldDelegate.leafCount != leafCount;
  }
}

// ==================== ПЛАШКА ПЕРЕСАДКИ ====================
class _RepotSheet extends StatefulWidget {
  final String baseUrl;
  final List<dynamic> pots;
  final dynamic currentPotId;
  final Duration? Function() getCooldown;
  final String Function(Duration) formatCooldown;

  const _RepotSheet({
    required this.baseUrl,
    required this.pots,
    required this.currentPotId,
    required this.getCooldown,
    required this.formatCooldown,
  });

  @override
  State<_RepotSheet> createState() => _RepotSheetState();
}

class _RepotSheetState extends State<_RepotSheet> {
  Timer? _timer;

  @override
  void initState() {
    super.initState();
    _timer = Timer.periodic(const Duration(seconds: 1), (_) {
      if (mounted) setState(() {});
    });
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  String _getRussianColor(String color) {
    switch (color.toLowerCase()) {
      case 'brown':
        return 'Коричневый';
      case 'yellow':
        return 'Жёлтый';
      case 'pink':
        return 'Розовый';
      default:
        return color;
    }
  }

  @override
  Widget build(BuildContext context) {
    final cooldown = widget.getCooldown();
    final canRepot = cooldown == null;

    return SingleChildScrollView(
      child: Container(
        margin: const EdgeInsets.all(20),
        padding: const EdgeInsets.all(20),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(30),
        ),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const Text(
              'Выберите горшок',
              style: TextStyle(
                  fontSize: 22,
                  fontWeight: FontWeight.bold,
                  color: Color(0xFF5D3A1A)),
            ),
            const SizedBox(height: 20),
            Wrap(
              spacing: 16,
              runSpacing: 16,
              children: widget.pots.map((pot) {
                final isSelected = widget.currentPotId == pot['id'];

                String imageUrl = '';
                if (pot['image'] != null &&
                    pot['image'].toString().isNotEmpty) {
                  String img = pot['image'].toString();
                  if (img.startsWith('http')) {
                    imageUrl = img;
                  } else if (img.startsWith('/media/')) {
                    imageUrl = '${widget.baseUrl}$img';
                  } else {
                    imageUrl = '${widget.baseUrl}/media/$img';
                  }
                }

                return GestureDetector(
                  onTap: canRepot
                      ? () => Navigator.pop(context, pot['id'])
                      : null,
                  child: Opacity(
                    opacity: canRepot ? 1.0 : 0.4,
                    child: Container(
                      width: 100,
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: isSelected
                            ? Colors.green.withOpacity(0.2)
                            : Colors.grey.withOpacity(0.1),
                        borderRadius: BorderRadius.circular(20),
                        border: isSelected
                            ? Border.all(color: Colors.green, width: 2)
                            : null,
                      ),
                      child: Column(
                        children: [
                          Container(
                            width: 70,
                            height: 70,
                            decoration: BoxDecoration(
                              color: Colors.transparent,
                              borderRadius: BorderRadius.circular(16),
                            ),
                            child: ClipRRect(
                              borderRadius: BorderRadius.circular(13),
                              child: imageUrl.isNotEmpty
                                  ? Image.network(
                                      imageUrl,
                                      fit: BoxFit.contain,
                                      width: 70,
                                      height: 70,
                                      loadingBuilder: (context, child,
                                          loadingProgress) {
                                        if (loadingProgress == null) {
                                          return child;
                                        }
                                        return Container(
                                          color: Colors.transparent,
                                          child: const Center(
                                            child: SizedBox(
                                              width: 30,
                                              height: 30,
                                              child:
                                                  CircularProgressIndicator(
                                                      strokeWidth: 2),
                                            ),
                                          ),
                                        );
                                      },
                                      errorBuilder:
                                          (context, error, stackTrace) {
                                        return Container(
                                          color:
                                              Colors.brown.withOpacity(0.3),
                                          child: const Icon(Icons.grass,
                                              size: 40,
                                              color: Colors.brown),
                                        );
                                      },
                                    )
                                  : Container(
                                      color: Colors.brown.withOpacity(0.3),
                                      child: const Icon(Icons.grass,
                                          size: 40, color: Colors.brown),
                                    ),
                            ),
                          ),
                          const SizedBox(height: 8),
                          Text(
                            _getRussianColor(pot['color'] ?? 'Горшок'),
                            style: TextStyle(
                              fontSize: 14,
                              fontWeight: FontWeight.w500,
                              color:
                                  isSelected ? Colors.green : Colors.brown,
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                );
              }).toList(),
            ),
            const SizedBox(height: 16),

            if (!canRepot && cooldown != null)
              Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                decoration: BoxDecoration(
                  color: const Color(0xFFB8453C).withOpacity(0.15),
                  borderRadius: BorderRadius.circular(20),
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    const Icon(Icons.timer,
                        color: Color(0xFFB8453C), size: 18),
                    const SizedBox(width: 6),
                    Text(
                      'Пересадка ${widget.formatCooldown(cooldown).toLowerCase()}',
                      style: const TextStyle(
                        fontSize: 13,
                        fontWeight: FontWeight.bold,
                        color: Color.fromARGB(255, 113, 71, 34),
                      ),
                    )
                  ],
                ),
              )
            else
              Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                decoration: BoxDecoration(
                  color: const Color(0xFF2E7D32).withOpacity(0.15),
                  borderRadius: BorderRadius.circular(20),
                ),
                child: const Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Icon(Icons.check_circle,
                        color: Color(0xFF2E7D32), size: 18),
                    SizedBox(width: 6),
                    Text(
                      'Можно пересадить (+3 монеты)',
                      style: TextStyle(
                        fontSize: 13,
                        fontWeight: FontWeight.bold,
                        color: Color(0xFF2E7D32),
                      ),
                    ),
                  ],
                ),
              ),

            const SizedBox(height: 16),
            ElevatedButton(
              onPressed: () => Navigator.pop(context, null),
              style: ElevatedButton.styleFrom(backgroundColor: Colors.grey),
              child: const Text('Отмена'),
            ),
          ],
        ),
      ),
    );
  }
}

// ==================== АНИМАЦИЯ ЛЕТЯЩЕЙ МОНЕТКИ ====================
class _FlyingCoin extends StatefulWidget {
  final Offset start;
  final Offset end;
  final VoidCallback onDone;

  const _FlyingCoin({
    required this.start,
    required this.end,
    required this.onDone,
  });

  @override
  State<_FlyingCoin> createState() => _FlyingCoinState();
}

class _FlyingCoinState extends State<_FlyingCoin>
    with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  late Animation<double> _t;

  @override
  void initState() {
    super.initState();
    _controller = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 700),
    );
    _t = CurvedAnimation(parent: _controller, curve: Curves.easeInOut);
    _controller.forward().whenComplete(() {
      if (mounted) {
        widget.onDone();
      }
    });
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _t,
      builder: (context, child) {
        final pos = Offset.lerp(widget.start, widget.end, _t.value)!;
        final arc = -60 * (1 - (2 * _t.value - 1).abs());
        return Positioned(
          left: pos.dx - 16,
          top: pos.dy - 16 + arc,
          child: Opacity(
            opacity: (1 - _t.value).clamp(0.0, 1.0),
            child: Transform.scale(
              scale: (1 - _t.value * 0.5).clamp(0.0, 1.0),
              child: Image.asset(
                'assets/images/achievements/coins.png',
                width: 32,
                height: 32,
                errorBuilder: (_, __, ___) => const Icon(
                  Icons.monetization_on,
                  color: Colors.amber,
                  size: 32,
                ),
              ),
            ),
          ),
        );
      },
    );
  }
}