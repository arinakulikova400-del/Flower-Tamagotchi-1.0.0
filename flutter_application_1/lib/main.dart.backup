          if (_showFertilizerNotification && _fertilizerNotification != null)
            Positioned(
              top: MediaQuery.of(context).padding.top + 90,
              left: 0,
              right: 0,
              child: Center(
                child: AnimatedOpacity(
                  opacity: _showFertilizerNotification ? 1.0 : 0.0,
                  duration: const Duration(milliseconds: 300),
                  child: Container(
                    decoration: BoxDecoration(
                      boxShadow: [
                        BoxShadow(
                          color: Colors.black.withOpacity(0.25),
                          blurRadius: 12,
                          offset: const Offset(0, 4),
                        ),
                      ],
                    ),
                    child: ClipPath(
                      clipper: _ChamferedClipper(cut: 14),
                      child: Container(
                        padding: const EdgeInsets.symmetric(
                            horizontal: 20, vertical: 14),
                        color: const Color.fromARGB(180, 96, 110, 97),
                        child: Row(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            if (_fertilizerImagePath != null)
                              SizedBox(
                                width: 40,
                                height: 40,
                                child: Image.asset(
                                  _fertilizerImagePath!,
                                  fit: BoxFit.contain,
                                  errorBuilder:
                                      (context, error, stackTrace) {
                                    return const Icon(Icons.eco,
