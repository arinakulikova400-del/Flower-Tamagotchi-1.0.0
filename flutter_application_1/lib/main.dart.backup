          // ==================== ЕЖЕДНЕВНЫЙ ВХОД ====================
          if (_showDailyLoginDialog)
            DailyLoginDialog(
              streak: _dailyStreak,
              reward: _dailyReward,
              onClaim: () async {
                setState(() {
                  _showDailyLoginDialog = false;
                });
                await _loadUserProfile();
              },
            ),

