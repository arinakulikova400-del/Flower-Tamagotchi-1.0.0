                                                    onPressed: (!isAlive ||
                                                            (_flower?[
                                                                        'water_level'] ??
                                                                    0) >=
                                                                100)
                                                        ? null
                                                        : _waterFlower,
                                                    icon: const Icon(
                                                        Icons.water_drop,
                                                        color: Colors.blue),
                                                    label: Text(
                                                      'Полить',
                                                      style: TextStyle(
                                                        fontSize: 16,
                                                        color: (!isAlive ||
                                                                (_flower?[
                                                                            'water_level'] ??
                                                                        0) >=
                                                                    100)
                                                            ? Colors.grey
                                                            : Colors.black,
                                                      ),
                                                    ),
                                                    style: ElevatedButton
                                                        .styleFrom(
                                                      backgroundColor:
                                                          Colors.white,
                                                      foregroundColor:
                                                          Colors.black,
                                                      padding: const EdgeInsets
                                                          .symmetric(
                                                          vertical: 14),
                                                      shape:
                                                          RoundedRectangleBorder(
                                                        borderRadius:
                                                            BorderRadius
                                                                .circular(30),
                                                        side: BorderSide(
                                                          color: (!isAlive ||
                                                                  (_flower?[
                                                                              'water_level'] ??
                                                                          0) >=
                                                                      100)
                                                              ? Colors.grey
                                                              : Colors.blue,
                                                        ),
                                                      ),
                                                    ),
                                                  ),
                                                ),
                                              ],
                                            ),
                                          ),
                                        ),
                                      ),
                                    ],
                                  ),
                          ),
                        ],
                      ),
          ),
          if (_showFlowerSelector && _flowerTypes.isNotEmpty)
            _buildSelectorOverlay(),
          if (_showLoginDialog)
            LoginDialog(
              onLogin: (username, password) async {
                final url = Uri.parse('$baseUrl/api/login/');
                final response = await http.post(
                  url,
                  headers: {'Content-Type': 'application/json'},
                  body: jsonEncode({
                    'username': username,
                    'password': password,
                  }),
                );

                if (response.statusCode == 200) {
                  final data = jsonDecode(response.body);
                  final token = data['token'] ?? data['key'];

                  if (token != null) {
                    _token = token;
                    _apiService = ApiService(baseUrl, _token);

                    final prefs = await SharedPreferences.getInstance();
                    await prefs.setString('auth_token', token);

                    if (mounted) {
                      setState(() {
                        _showLoginDialog = false;
                        _isAuthenticated = true;
                      });
                      await _loadData();
                      await _loadUserProfile();
                      await _loadAchievements();
                      await _checkDailyLogin();
                    }
                    return true;
                  }
                }

                if (mounted) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(
                        content: Text('Ошибка входа'),
                        backgroundColor: Color.fromARGB(255, 142, 62, 57)),
                  );
                }
                return false;
              },
              onRegister: (username, email, password) async {
                final registerUrl = Uri.parse('$baseUrl/api/register/');
                final registerResponse = await http.post(
                  registerUrl,
                  headers: {'Content-Type': 'application/json'},
                  body: jsonEncode({
                    'username': username,
                    'email': email,
                    'password': password,
                  }),
                );

                if (registerResponse.statusCode == 201 ||
                    registerResponse.statusCode == 200) {
                  final loginUrl = Uri.parse('$baseUrl/api/login/');
                  final loginResponse = await http.post(
                    loginUrl,
                    headers: {'Content-Type': 'application/json'},
                    body: jsonEncode({
                      'username': username,
                      'password': password,
                    }),
                  );

                  if (loginResponse.statusCode == 200) {
                    final data = jsonDecode(loginResponse.body);
                    final token = data['token'] ?? data['key'];

                    if (token != null) {
                      _token = token;
                      _apiService = ApiService(baseUrl, _token);

                      final prefs = await SharedPreferences.getInstance();
                      await prefs.setString('auth_token', token);

                      if (mounted) {
                        setState(() {
                          _showLoginDialog = false;
                          _isAuthenticated = true;
                        });
                        await _loadData();
                        await _loadUserProfile();
                        await _loadAchievements();
                        await _checkDailyLogin();
                      }
                      return true;
                    }
                  }
                }

                if (mounted) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(
                        content: Text('Ошибка регистрации'),
                        backgroundColor: Color.fromARGB(255, 142, 62, 57)),
                  );
                }
                return false;
              },
            ),
          if (_showProfileDialog)
            Stack(
              children: [
                Container(
                  color: Colors.black.withOpacity(0.7),
                  child: GestureDetector(
                    onTap: () => setState(() => _showProfileDialog = false),
